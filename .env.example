# Copy values into your deployment environment. Django does NOT auto-load .env.
# Keep real secrets out of git and client-side JavaScript.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=false

# Optional structured needs extraction. Basic local matching works without a key.
OPENAI_API_KEY=
TRIAGE_USE_LLM=true
TRIAGE_MODEL=gpt-4.1-mini

# Optional browser audio recording -> server -> OpenAI transcription.
VOICE_USE_API=false
TRANSCRIPTION_MODEL=gpt-transcribe

# Optional Streamable HTTP MCP. Use a DIFFERENT random secret, >=32 bytes.
MCP_API_KEY=
# Exact public host[:port] behind your HTTPS proxy. No wildcards.
MCP_ALLOWED_HOSTS=
# Exact browser origins, if required. Empty rejects all Origin-bearing requests.
MCP_ALLOWED_ORIGINS=
